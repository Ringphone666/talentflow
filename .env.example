# TalentFlow人力资源智能体平台配置示例
# 复制为 .env 后填写。.env 含密钥，不要提交到代码库或发给无关人员。
# 进程环境变量优先于本文件，服务器部署时可由运维注入密钥。

# ---- 模型网关（人岗匹配和 AI 面试共用）----
TALENTFLOW_MODEL_BASE_URL=https://model.example.invalid/v1
TALENTFLOW_LLM_API_KEY=

# ---- 人岗匹配 ----
# external：使用外部模型评分；local_rules：不联网（只能导入和查看资料，不能评分）
MODEL_PROVIDER=local_rules
# 已确认上面的密钥可用后设为 true，否则不会调用外部模型
TALENTFLOW_MATCH_KEY_ROTATED_CONFIRMED=false
# 模型网关是 http 地址时需为 true
TALENTFLOW_MATCH_ALLOW_HTTP=false
TALENTFLOW_MATCH_CHAT_MODEL=chat-primary
TALENTFLOW_MATCH_REASONING_MODEL=chat-reasoner
TALENTFLOW_MATCH_OCR_PROVIDER=paddle_chat
# 人岗匹配使用另一套网关或密钥时才需要填写，默认沿用上面的共用配置
# TALENTFLOW_MATCH_LLM_BASE_URL=
# TALENTFLOW_MATCH_LLM_API_KEY=
# 单个匹配任务的人数上限（默认 20，可配置）
TALENTFLOW_MATCHING_UPLOAD_LIMIT=20
# 同时分析的任务数
MATCHING_TASK_WORKERS=2

# ---- AI 面试 ----
# live：使用文本模型；测试环境用 mock
TALENTFLOW_TEXT_MODE=live
# doubao：豆包流式语音识别；不配置密钥时语音转写不可用
TALENTFLOW_ASR_MODE=doubao
DOUBAO_ASR_API_KEY=
# 发言人区分（3D-Speaker 本地服务）：live / disabled
TALENTFLOW_SPEAKER_MODE=disabled
TALENTFLOW_SPEAKER_BASE_URL=http://127.0.0.1:9200
TALENTFLOW_DIARIZATION_BASE_URL=http://127.0.0.1:9201
# 文字识别、强制对齐服务的地址；必须显式配置；代码只提供不可访问的示例地址
# TALENTFLOW_OCR_BASE_URL=https://ocr.example.invalid
# TALENTFLOW_ALIGNER_BASE_URL=https://aligner.example.invalid
# TALENTFLOW_ALIGNER_ROUTE_ID=configure-route
# 候选人随机密码位数（8–32）
TALENTFLOW_CANDIDATE_PASSWORD_LENGTH=12
# 候选人对比默认选中人数上限；0 表示该批次全部
TALENTFLOW_COMPARISON_DEFAULT_LIMIT=0

# ---- 入口与会话 ----
# local：本机管理入口（只接受本机访问）；host：由主系统后端授权进入
TALENTFLOW_ADMIN_ENTRY_MODE=local
# host 模式下主系统调用授权接口使用的密钥，至少 32 位
TALENTFLOW_HOST_ENTRY_SECRET=
# 会话签名密钥，至少 32 位；不填时首次启动自动生成并保存在 .secrets/
TALENTFLOW_SESSION_SECRET=

# ---- 运行 ----
TALENTFLOW_RUNTIME_PROFILE=production
TALENTFLOW_API_HOST=127.0.0.1
TALENTFLOW_API_PORT=8000
# 前端开发服务器端口；语音连接只接受来自前端页面的请求
TALENTFLOW_WEB_PORT=5173
# 前端不在本机默认地址时，填写页面的完整来源，多个用逗号分隔，例如 https://hr.example.com
# TALENTFLOW_WEB_ORIGINS=
# 数据目录，默认为平台目录下的 data/
# TALENTFLOW_HR_DATA_DIR=

# 文字识别默认关闭；配置自己的服务后设为 live
TALENTFLOW_OCR_MODE=disabled
